{
  "name": "react-native-matrix-crypto-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "docs": "typedoc",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate:workspaces": "./scripts/assert-workspaces.sh",
    "gate:boundary": "./scripts/assert-core-boundary.sh",
    "gate:drift": "./scripts/assert-no-drift.sh",
    "gate:logger": "./scripts/assert-no-logger.sh",
    "gate:agility": "./scripts/assert-facade-agility.sh",
    "gate:readme": "./scripts/assert-readme-sync.sh",
    "gate:uia-example": "./scripts/assert-uia-example.sh",
    "gate:stubs": "./scripts/assert-generated-not-stubbed.sh",
    "gate:ignores": "./scripts/assert-formatter-ignores.sh",
    "gate:lint-coverage": "./scripts/assert-lint-coverage.sh",
    "gate:surface": "./scripts/assert-public-surface.sh",
    "gate:doc-links": "./scripts/assert-doc-links.sh",
    "gate:measure-guards": "./scripts/assert-measure-guards.sh",
    "gate:measure-guards-ios": "./scripts/assert-measure-guards-ios.sh",
    "gate:artifact-provenance": "./scripts/assert-artifact-provenance.sh",
    "audit:deps": "./scripts/audit-dependencies.sh"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.87.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3"
