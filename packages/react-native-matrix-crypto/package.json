{
  "name": "react-native-matrix-crypto",
  "version": "0.1.0",
  "description": "A React Native bridge for Matrix cryptography",
  "license": "Apache-2.0",
  "homepage": "https://github.com/linagora/react-native-matrix-crypto",
  "author": "Linagora",
  "repository": {
    "type": "git",
    "url": "https://github.com/linagora/react-native-matrix-crypto.git"
  },
  "main": "src/index.ts",
  "files": ["src", "cpp", "interop", "android", "ios", "*.podspec", "LICENSE"],
  "codegenConfig": {
    "name": "RNNativeModuleSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.matrixcrypto"
    }
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.87.0"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-5",
    "uniffi-bindgen-react-native": "0.31.0-5"
  },
  "devDependencies": {
    "@types/react": "^19.1.1",
    "react": "^19.2.3",
    "react-native": "^0.87.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "codegen": "./scripts/codegen.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
